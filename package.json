    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vue-tsc": "^3.1.1"
  }
}
