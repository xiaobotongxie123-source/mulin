# ── Game agent bridge ─────────────────────────────────────────────
# OpenAI-compatible endpoint used to generate each AI traveller's speech.
# Qiniu MaaS example: https://api.qnaigc.com/v1
AGENT_LLM_BASE_URL=https://api.qnaigc.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek/deepseek-v4-flash-20260731

# Set to 1 to run the bridge without a key (deterministic persona lines).
# Useful for UI development only; not a real LLM.
AGENT_LLM_MOCK=0
AGENT_TIMEOUT_MS=12000

# ── Linx / Xrobot agent provisioning (optional) ───────────────────
# API key: https://xrobo.qiniu.com/#/api-key-management
XROBO_API_KEY=
XROBO_BASE_URL=https://xrobo.qiniu.com
XROBO_LLM_MODEL_ID=f3626c105383d71654a57f2bb8a973f3
XROBO_MEM_MODEL_ID=Memory_nomem
XROBO_INTENT_MODEL_ID=Intent_nointent
XROBO_AGENT_PREFIX=暮林夜话
# Xrobot device websocket used by the server-side TTS bridge.
XROBO_TTS_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
# MAC of a device already bound to this XRobot account (used only server-side).
# If it is not bound, the browser falls back to its own Chinese voice.
XROBO_TTS_DEVICE_MAC=02:00:00:00:00:02
